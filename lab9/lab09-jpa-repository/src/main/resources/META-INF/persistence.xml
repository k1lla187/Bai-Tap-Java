<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="lab09PU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        
        <!-- Entities -->
        <class>vn.edu.eaut.lab9.model.SinhVien</class>
        <class>vn.edu.eaut.lab9.model.LopHoc</class>
        <class>vn.edu.eaut.lab9.model.MonHoc</class>
        <class>vn.edu.eaut.lab9.model.Diem</class>
        <class>vn.edu.eaut.lab9.model.User</class>
        <class>vn.edu.eaut.lab9.model.Role</class>

        <properties>
            <!-- JDBC Connection -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" 
                      value="jdbc:mysql://localhost:3306/lab09_jpa?useUnicode=true&amp;characterEncoding=UTF-8&amp;serverTimezone=Asia/Ho_Chi_Minh&amp;allowPublicKeyRetrieval=true&amp;useSSL=false"/>
        <!-- MySQL credentials: set in environment or replace locally before running -->
        <property name="jakarta.persistence.jdbc.user" value="lab09admin"/>
        <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- Hibernate Settings -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
