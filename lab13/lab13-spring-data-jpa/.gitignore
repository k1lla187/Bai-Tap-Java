# .gitignore cho Spring Boot Project

# Compiled class files
*.class
target/
*.jar
*.war
*.ear

# Log files
*.log

# Maven
.mvn/
mvnw
mvnw.cmd

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.project
.classpath
.settings/
bin/

# VS Code
.vscode/

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# Application properties với sensitive data
application-prod.properties
application-local.properties

# H2 Database files (nếu dùng file-based)
*.db
*.mv.db
*.trace.db

# Temporary files
*.tmp
*.bak
*.swp
*~
